{
  "name": "playwright-typescript-e2e-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Production-safe Playwright + TypeScript E2E framework for two live sites: a home care agency and a cross-border e-commerce store.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "test:api": "playwright test --grep @api",
    "test:mobile": "playwright test --grep @mobile",
    "test:faithfulness": "playwright test --project='faithfulness-*'",
    "test:afrishop": "playwright test --project='afrishop-*'",
    "test:chromium": "playwright test --project='*-chromium' --project='*-api'",
    "visual:update": "docker compose run --rm visual-update",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "prepare": "husky",
    "test:visual:docker": "docker compose run --rm playwright",
    "report:allure": "allure generate allure-results && allure open allure-report"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml,mjs}": [
      "prettier --check"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "allure": "3.20.1",
    "allure-js-commons": "3.13.0",
    "allure-playwright": "3.13.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "zod": "^4.6.7"
  }
}
