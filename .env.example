# Copy to .env and adjust. Every variable is optional; defaults target production.

# Base URLs of the systems under test
FAITHFULNESS_BASE_URL=https://faithfulnesshomecare.com
AFRISHOP_BASE_URL=https://afrishop-usa.com

# Parallel workers against production. Keep this low: these are live business sites.
WORKERS=2

# Response-time budget (ms) for document requests in API tests
API_RESPONSE_BUDGET_MS=2500

# Page-load budgets (ms) used by the light performance checks
PERF_LCP_BUDGET_MS=4000
PERF_LOAD_BUDGET_MS=6000

# Max concurrent requests used by the sitemap/link checkers
LINK_CHECK_CONCURRENCY=4
